{
  "name": "spryclips",
  "version": "1.0.0",
  "private": true,
  "description": "Spryclips - Short video sharing platform built with React",
  "dependencies": {
    "ajv": "^6.12.6",
    "ajv-keywords": "^3.5.2",
    "axios": "^1.3.4",
    "dompurify": "^3.3.0",
    "lucide-react": "^0.552.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.8.0",
    "react-scripts": "^5.0.1",
    "react-window": "^2.2.3",
    "react-window-infinite-loader": "^2.0.0",
    "socket.io-client": "^4.8.1",
    "zustand": "^5.0.8"
  },
  "scripts": {
    "start": "cross-env NODE_OPTIONS=--no-deprecation react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "jest": {
    "transformIgnorePatterns": [
      "node_modules/(?!axios)/"
    ]
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ],
    "globals": {
      "tf": "readonly",
      "faceLandmarksDetection": "readonly"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^14.2.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^18.19.50",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.19",
    "concurrently": "^7.6.0",
    "cross-env": "^7.0.3",
    "typescript": "^4.9.5"
  }
}
